#!/bin/bash

# ============================================================
# sabid - SSH/SCP Helper
# Compatible with macOS and Ubuntu
# ============================================================

CSV="$HOME/.ssh/quickssh/servers.csv"
SSH_DIR="$HOME/.ssh/quickssh"

# ============================================================
# Clean CSV
# ============================================================
# Removes Windows CRLF characters.
#
# Works on:
#   macOS
#   Ubuntu
#
# This prevents problems such as:
#   Invalid port: 22
#   because the actual value may be "22\r"
# ============================================================

clean_csv() {

    if [ ! -f "$CSV" ]; then
        return 0
    fi

    if command -v perl >/dev/null 2>&1; then
        perl -pi -e 's/\r$//' "$CSV"
    else
        echo "Warning: perl is not installed."
        echo "CSV cleanup was skipped."
    fi

    chmod 600 "$CSV"
}

# ============================================================
# Initialize
# ============================================================

init() {

    mkdir -p "$SSH_DIR"
    chmod 700 "$SSH_DIR"

    if [ ! -f "$CSV" ]; then
        echo "alias_name,server_username,server_ip,password,port" > "$CSV"
    fi

    chmod 600 "$CSV"

    # Always clean CSV automatically
    clean_csv
}

# ============================================================
# Requirements
# ============================================================

check_requirements() {

    if ! command -v ssh >/dev/null 2>&1; then
        echo "Error: ssh is not installed."
        exit 1
    fi

    if ! command -v sshpass >/dev/null 2>&1; then
        echo "Error: sshpass is not installed."
        echo
        echo "macOS:"
        echo "  brew install hudochenkov/sshpass/sshpass"
        echo
        echo "Ubuntu/Debian:"
        echo "  sudo apt-get update"
        echo "  sudo apt-get install sshpass"
        exit 1
    fi
}

# ============================================================
# Help
# ============================================================

show_help() {

    cat <<EOF

sabid - SSH/SCP helper

USAGE
-----

SSH:

  sabid ssh list
  sabid ssh list <alias>
  sabid ssh clean

  sabid ssh <alias>
  sabid ssh <alias> <user>

  sabid ssh <alias> --user <user>
  sabid ssh <alias> --port <port>
  sabid ssh <alias> --debug

ADD:

  sabid ssh add <alias> <user> <host>
  sabid ssh add <alias> <user> <host> <password>
  sabid ssh add <alias> <user> <host> <password> <port>

  If password is omitted, it will be requested securely.

REMOVE:

  sabid ssh remove <alias>
  sabid ssh remove --all

SCP:

  sabid scp <alias> <SRC> <DST>

  sabid scp --user <user> <alias> <SRC> <DST>

  sabid scp --port <port> <alias> <SRC> <DST>

EXAMPLES
--------

  sabid ssh list

  sabid ssh list us

  sabid ssh clean

  sabid ssh us

  sabid ssh us sabid

  sabid ssh us --user sabid

  sabid ssh us --port 2222

  sabid ssh us --debug

  sabid ssh add us sabid 10.165.197.58

  sabid ssh remove us

  sabid scp us ./file.txt /tmp/file.txt

CSV FILE
--------

  $CSV

CSV FORMAT
----------

  alias_name,server_username,server_ip,password,port

SECURITY
--------

  The password is stored in plaintext in servers.csv.

  The file permissions are automatically set to:

  600

EOF
}

# ============================================================
# Get server from CSV
# ============================================================
#
# Sets:
#   SERVER_USER
#   SERVER_HOST
#   SERVER_PASSWORD
#   SERVER_PORT
#
# ============================================================

read_server() {

    clean_csv

    local wanted_alias="$1"

    SERVER_USER=""
    SERVER_HOST=""
    SERVER_PASSWORD=""
    SERVER_PORT="22"

    while IFS=',' read -r csv_alias csv_user csv_host csv_password csv_port
    do

        # Skip header
        [ "$csv_alias" = "alias_name" ] && continue

        # Skip empty rows
        [ -z "$csv_alias" ] && continue

        if [ "$csv_alias" = "$wanted_alias" ]; then

            SERVER_USER="$csv_user"
            SERVER_HOST="$csv_host"
            SERVER_PASSWORD="$csv_password"

            if [ -n "$csv_port" ]; then
                SERVER_PORT="$csv_port"
            fi

            return 0
        fi

    done < "$CSV"

    return 1
}

# ============================================================
# List servers
# ============================================================

list_servers() {

    clean_csv

    local wanted_alias="$1"
    local found=0

    while IFS=',' read -r alias user host password port
    do

        # Skip header
        [ "$alias" = "alias_name" ] && continue

        # Skip empty/broken rows
        [ -z "$alias" ] && continue
        [ -z "$user" ] && continue
        [ -z "$host" ] && continue

        # If specific alias requested
        if [ -n "$wanted_alias" ] && [ "$alias" != "$wanted_alias" ]; then
            continue
        fi

        found=1

        echo
        echo "Server Details:"
        echo
        echo "  Alias    : $alias"
        echo "  User     : $user"
        echo "  Host     : $host"
        echo "  Port     : ${port:-22}"
        echo "  Password : ********"

    done < "$CSV"

    if [ "$found" -eq 0 ]; then

        if [ -n "$wanted_alias" ]; then
            echo
            echo "Server not found: $wanted_alias"
        else
            echo
            echo "No servers configured."
        fi

    fi

    echo
}

# ============================================================
# Add server
# ============================================================

add_server() {

    clean_csv

    local alias="$1"
    local user="$2"
    local host="$3"
    local password="$4"
    local port="$5"

    if [ -z "$alias" ] || [ -z "$user" ] || [ -z "$host" ]; then

        echo "Usage:"
        echo
        echo "  sabid ssh add <alias> <user> <host> [password] [port]"
        echo

        return 1
    fi

    # Default port
    if [ -z "$port" ]; then
        port="22"
    fi

    # Check duplicate alias
    if awk -F',' -v a="$alias" '
        NR > 1 && $1 == a {
            found=1
        }
        END {
            exit !found
        }
    ' "$CSV"; then

        echo "Alias already exists: $alias"
        return 1
    fi

    # Ask password if omitted
    if [ -z "$password" ]; then

        printf "Password for %s@%s: " "$user" "$host"

        stty -echo
        read -r password
        stty echo

        echo
    fi

    printf '%s,%s,%s,%s,%s\n' \
        "$alias" \
        "$user" \
        "$host" \
        "$password" \
        "$port" >> "$CSV"

    chmod 600 "$CSV"

    # Clean after writing
    clean_csv

    echo
    echo "Server added successfully."
    echo

    list_servers "$alias"
}

# ============================================================
# Remove server
# ============================================================

remove_server() {

    clean_csv

    local alias="$1"

    if [ -z "$alias" ]; then

        echo "Usage:"
        echo
        echo "  sabid ssh remove <alias>"
        echo "  sabid ssh remove --all"

        return 1
    fi

    # --------------------------------------------------------
    # Remove all
    # --------------------------------------------------------

    if [ "$alias" = "--all" ]; then

        printf "Remove ALL servers? [y/N]: "
        read -r answer

        case "$answer" in

            y|Y|yes|YES)

                echo "alias_name,server_username,server_ip,password,port" > "$CSV"

                chmod 600 "$CSV"

                echo "All servers removed."

                ;;

            *)

                echo "Cancelled."

                ;;

        esac

        return 0
    fi

    # --------------------------------------------------------
    # Check alias
    # --------------------------------------------------------

    if ! awk -F',' -v a="$alias" '
        NR > 1 && $1 == a {
            found=1
        }
        END {
            exit !found
        }
    ' "$CSV"; then

        echo "Server not found: $alias"
        return 1
    fi

    # --------------------------------------------------------
    # Remove
    # --------------------------------------------------------

    local temp_file

    temp_file="$(mktemp)"

    awk -F',' -v a="$alias" '
        NR == 1 {
            print
            next
        }

        $1 != a {
            print
        }
    ' OFS=',' "$CSV" > "$temp_file"

    mv "$temp_file" "$CSV"

    chmod 600 "$CSV"

    clean_csv

    echo "Server removed: $alias"
}

# ============================================================
# SSH connection
# ============================================================

ssh_connect() {

    local alias="$1"

    shift

    if [ -z "$alias" ]; then
        show_help
        return 1
    fi

    local requested_user=""
    local requested_port=""
    local debug=0

    # --------------------------------------------------------
    # Parse arguments
    # --------------------------------------------------------

    while [ $# -gt 0 ]
    do

        case "$1" in

            --user|-u)

                if [ -z "$2" ]; then
                    echo "--user requires a value."
                    return 1
                fi

                requested_user="$2"

                shift 2

                ;;

            --port|-p)

                if [ -z "$2" ]; then
                    echo "--port requires a value."
                    return 1
                fi

                requested_port="$2"

                shift 2

                ;;

            --debug|-d)

                debug=1

                shift

                ;;

            --help|-h)

                show_help

                return 0

                ;;

            -*)

                echo "Unknown option: $1"

                return 1

                ;;

            *)

                # Positional username
                if [ -z "$requested_user" ]; then
                    requested_user="$1"
                else
                    echo "Unknown argument: $1"
                    return 1
                fi

                shift

                ;;

        esac

    done

    # --------------------------------------------------------
    # Read server
    # --------------------------------------------------------

    if ! read_server "$alias"; then

        echo "Server not found: $alias"

        echo

        echo "Available servers:"

        list_servers

        return 1
    fi

    local user="$SERVER_USER"
    local host="$SERVER_HOST"
    local password="$SERVER_PASSWORD"
    local port="$SERVER_PORT"

    # Apply overrides

    if [ -n "$requested_user" ]; then
        user="$requested_user"
    fi

    if [ -n "$requested_port" ]; then
        port="$requested_port"
    fi

    # Default port

    if [ -z "$port" ]; then
        port="22"
    fi

    # --------------------------------------------------------
    # Password
    # --------------------------------------------------------

    if [ -z "$password" ]; then

        printf "Password for %s@%s: " "$user" "$host"

        stty -echo
        read -r password
        stty echo

        echo
    fi

    # --------------------------------------------------------
    # Connection information
    # --------------------------------------------------------

    echo
    echo "Connecting to $user@$host:$port..."
    echo

    # --------------------------------------------------------
    # SSH
    # --------------------------------------------------------

    if [ "$debug" -eq 1 ]; then

        echo "Debug mode enabled."
        echo

        SSHPASS="$password" \
        sshpass -e \
        ssh \
            -vvv \
            -p "$port" \
            -o StrictHostKeyChecking=no \
            -o UserKnownHostsFile=/dev/null \
            -o PreferredAuthentications=password \
            -o PubkeyAuthentication=no \
            "$user@$host"

    else

        SSHPASS="$password" \
        sshpass -e \
        ssh \
            -p "$port" \
            -o StrictHostKeyChecking=no \
            -o UserKnownHostsFile=/dev/null \
            -o PreferredAuthentications=password \
            -o PubkeyAuthentication=no \
            "$user@$host"

    fi

    local rc=$?

    echo

    if [ "$rc" -eq 0 ]; then
        echo "SSH session ended."
    else
        echo "SSH failed with exit code: $rc"
    fi

    return "$rc"
}

# ============================================================
# SCP
# ============================================================

scp_connect() {

    local user_override=""
    local port_override=""

    # --------------------------------------------------------
    # Options
    # --------------------------------------------------------

    while [ $# -gt 0 ]
    do

        case "$1" in

            --user|-u)

                if [ -z "$2" ]; then
                    echo "--user requires a value."
                    return 1
                fi

                user_override="$2"

                shift 2

                ;;

            --port|-p)

                if [ -z "$2" ]; then
                    echo "--port requires a value."
                    return 1
                fi

                port_override="$2"

                shift 2

                ;;

            --help|-h)

                show_help

                return 0

                ;;

            *)

                break

                ;;

        esac

    done

    local alias="$1"
    local source="$2"
    local destination="$3"

    if [ -z "$alias" ] || [ -z "$source" ] || [ -z "$destination" ]; then

        echo "Usage:"
        echo
        echo "  sabid scp [--user USER] [--port PORT] <alias> <SRC> <DST>"

        return 1
    fi

    # --------------------------------------------------------
    # Read server
    # --------------------------------------------------------

    if ! read_server "$alias"; then

        echo "Server not found: $alias"

        return 1
    fi

    local user="$SERVER_USER"
    local host="$SERVER_HOST"
    local password="$SERVER_PASSWORD"
    local port="$SERVER_PORT"

    if [ -n "$user_override" ]; then
        user="$user_override"
    fi

    if [ -n "$port_override" ]; then
        port="$port_override"
    fi

    if [ -z "$port" ]; then
        port="22"
    fi

    # --------------------------------------------------------
    # Password
    # --------------------------------------------------------

    if [ -z "$password" ]; then

        printf "Password for %s@%s: " "$user" "$host"

        stty -echo
        read -r password
        stty echo

        echo
    fi

    # --------------------------------------------------------
    # Copy
    # --------------------------------------------------------

    echo
    echo "Copying:"
    echo
    echo "  Source      : $source"
    echo "  Server      : $user@$host:$port"
    echo "  Destination : $destination"
    echo

    SSHPASS="$password" \
    sshpass -e \
    scp \
        -P "$port" \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        "$source" \
        "$user@$host:$destination"

    return $?
}

# ============================================================
# Main
# ============================================================

main() {

    init

    check_requirements

    if [ $# -eq 0 ]; then
        show_help
        return 0
    fi

    case "$1" in

        help|--help|-h)

            show_help

            ;;

        ssh)

            shift

            if [ $# -eq 0 ]; then
                show_help
                return 0
            fi

            case "$1" in

                # ------------------------------------------------
                # Clean CSV
                # ------------------------------------------------

                clean)

                    clean_csv

                    echo "CSV cleaned successfully:"
                    echo "  $CSV"

                    ;;

                # ------------------------------------------------
                # List
                # ------------------------------------------------

                list)

                    shift

                    list_servers "${1:-}"

                    ;;

                # ------------------------------------------------
                # Add
                # ------------------------------------------------

                add)

                    shift

                    add_server "$@"

                    ;;

                # ------------------------------------------------
                # Remove
                # ------------------------------------------------

                remove)

                    shift

                    remove_server "$@"

                    ;;

                # ------------------------------------------------
                # SSH
                # ------------------------------------------------

                *)

                    ssh_connect "$@"

                    ;;

            esac

            ;;

        scp)

            shift

            scp_connect "$@"

            ;;

        *)

            echo "Unknown command: $1"
            echo

            show_help

            return 1

            ;;

    esac
}

# ============================================================
# Run
# ============================================================

main "$@"
