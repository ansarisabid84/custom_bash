# ============================================================
# Validate port
# ============================================================

validate_port() {

    local port="$1"


    if ! [[ "$port" =~ ^[0-9]+$ ]]; then

        echo -e "${RED}Invalid port: $port${NC}"
        return 1
    fi


    if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then

        echo -e "${RED}Invalid port: $port${NC}"
        return 1
    fi


    return 0
}


# ============================================================
# Resolve alias
#
# Exact:
#   us
#
# One partial:
#   us-m
#   -> us-mongodb
#
# Multiple:
#   u
#   -> interactive selection
#
# Result:
#   MATCHED_ALIAS
# ============================================================

resolve_alias() {

    clean_csv

    local input="$1"

    local alias
    local user
    local host
    local password
    local port

    local exact_match=""
    local matches=""
    local count=0


    # --------------------------------------------------------
    # Exact match
    # --------------------------------------------------------

    while IFS=',' read -r alias user host password port
    do

        [ "$alias" = "alias_name" ] && continue
        [ -z "$alias" ] && continue

        if [ "$alias" = "$input" ]; then

            exact_match="$alias"

            break
        fi

    done < "$CSV"


    if [ -n "$exact_match" ]; then

        MATCHED_ALIAS="$exact_match"

        return 0
    fi


    # --------------------------------------------------------
    # Prefix matches
    # --------------------------------------------------------

    while IFS=',' read -r alias user host password port
    do

        [ "$alias" = "alias_name" ] && continue
        [ -z "$alias" ] && continue


        case "$alias" in

            "$input"*)

                count=$((count + 1))

                if [ -z "$matches" ]; then

                    matches="$alias"

                else

                    matches="$matches
$alias"

                fi

                ;;

        esac

    done < "$CSV"


    # --------------------------------------------------------
    # No match
    # --------------------------------------------------------

    if [ "$count" -eq 0 ]; then

        echo
        echo -e "${RED}No server matches: $input${NC}"
        echo

        return 1
    fi


    # --------------------------------------------------------
    # Sort alphabetically
    # --------------------------------------------------------

    matches=$(printf '%s\n' "$matches" | sort)


    # --------------------------------------------------------
    # One match
    # --------------------------------------------------------

    if [ "$count" -eq 1 ]; then

        MATCHED_ALIAS="$matches"

        return 0
    fi


    # --------------------------------------------------------
    # Multiple matches
    # --------------------------------------------------------

    echo
    echo -e "${CYAN}What do you mean by '$input'?${NC}"
    echo


    local index=1


    while IFS= read -r alias
    do

        echo "  $index) $alias"

        index=$((index + 1))

    done <<< "$matches"


    echo
    echo "Enter number or exact alias:"
    echo


    # --------------------------------------------------------
    # Selection
    # --------------------------------------------------------

    while true
    do

        printf "> "

        read -r selection


        # ----------------------------------------------------
        # Cancel
        # ----------------------------------------------------

        case "$selection" in

            q|Q|quit|QUIT|exit|EXIT)

                echo
                echo "Cancelled."
                echo

                return 1
                ;;

        esac


        # ----------------------------------------------------
        # Empty
        # ----------------------------------------------------

        if [ -z "$selection" ]; then

            echo
            echo "Please enter a number or exact alias."
            echo

            continue
        fi


        # ----------------------------------------------------
        # Number
        # ----------------------------------------------------

        if [[ "$selection" =~ ^[0-9]+$ ]]; then

            if [ "$selection" -ge 1 ] &&
               [ "$selection" -le "$count" ]; then

                MATCHED_ALIAS=$(printf '%s\n' "$matches" |
                    sed -n "${selection}p")

                return 0
            fi


            echo
            echo "Invalid selection."
            echo "Please choose a number between 1 and $count."
            echo

            continue
        fi


        # ----------------------------------------------------
        # Exact alias from suggestions
        # ----------------------------------------------------

        local found=0


        while IFS= read -r alias
        do

            if [ "$selection" = "$alias" ]; then

                MATCHED_ALIAS="$alias"

                found=1

                break
            fi

        done <<< "$matches"


        if [ "$found" -eq 1 ]; then

            return 0
        fi


        echo
        echo "Invalid alias: $selection"
        echo "Please enter a number or one of the listed aliases."
        echo

    done
}


# ============================================================
# Get server information
# ============================================================

get_server() {

    local target_alias="$1"

    SERVER_USER=""
    SERVER_HOST=""
    SERVER_PASSWORD=""
    SERVER_PORT=""


    local alias
    local user
    local host
    local password
    local port


    while IFS=',' read -r alias user host password port
    do

        [ "$alias" = "alias_name" ] && continue
        [ -z "$alias" ] && continue


        if [ "$alias" = "$target_alias" ]; then

            SERVER_USER="$user"
            SERVER_HOST="$host"
            SERVER_PASSWORD="$password"
            SERVER_PORT="$port"

            return 0
        fi

    done < "$CSV"


    return 1
}


# ============================================================
# Common SSH options
# ============================================================

get_ssh_options() {

    SSH_OPTIONS=(
        "-o"
        "StrictHostKeyChecking=accept-new"

        "-o"
        "PreferredAuthentications=password"

        "-o"
        "PubkeyAuthentication=no"
    )
}


# ============================================================
# SSH Connect
# ============================================================

ssh_connect() {

    local input_alias="$1"

    shift


    local custom_user=""
    local custom_port=""
    local debug=0


    # --------------------------------------------------------
    # Parse arguments
    # --------------------------------------------------------

    while [ $# -gt 0 ]
    do

        case "$1" in

            --user)

                if [ -z "$2" ]; then

                    echo -e "${RED}Error: --user requires a value.${NC}"

                    return 1
                fi

                custom_user="$2"

                shift 2
                ;;


            --port)

                if [ -z "$2" ]; then

                    echo -e "${RED}Error: --port requires a value.${NC}"

                    return 1
                fi

                custom_port="$2"

                shift 2
                ;;


            --debug)

                debug=1

                shift
                ;;


            --help|-h)

                show_help

                return 0
                ;;


            -*)

                echo -e "${RED}Unknown option: $1${NC}"
                echo "Use: sabid ssh --help"

                return 1
                ;;


            *)

                if [ -z "$custom_user" ]; then

                    custom_user="$1"

                    shift

                else

                    echo -e "${RED}Unexpected argument: $1${NC}"

                    return 1
                fi

                ;;

        esac

    done


    # --------------------------------------------------------
    # Resolve alias
    # --------------------------------------------------------

    if ! resolve_alias "$input_alias"; then

        return 1
    fi


    local alias="$MATCHED_ALIAS"


    # --------------------------------------------------------
    # Get server
    # --------------------------------------------------------

    if ! get_server "$alias"; then

        echo -e "${RED}Server not found: $alias${NC}"

        return 1
    fi


    local user="$SERVER_USER"
    local host="$SERVER_HOST"
    local password="$SERVER_PASSWORD"
    local port="$SERVER_PORT"


    # --------------------------------------------------------
    # Apply overrides
    # --------------------------------------------------------

    [ -n "$custom_user" ] && user="$custom_user"

    [ -n "$custom_port" ] && port="$custom_port"


    # --------------------------------------------------------
    # Default port
    # --------------------------------------------------------

    [ -z "$port" ] && port=22


    # --------------------------------------------------------
    # Validate
    # --------------------------------------------------------

    if ! validate_port "$port"; then

        return 1
    fi


    if [ -z "$user" ]; then

        echo -e "${RED}Username is empty for alias: $alias${NC}"

        return 1
    fi


    if [ -z "$host" ]; then

        echo -e "${RED}Host is empty for alias: $alias${NC}"

        return 1
    fi


    # --------------------------------------------------------
    # Password
    # --------------------------------------------------------

    if [ -z "$password" ]; then

        echo
        echo "Password required for $user@$host"

        read -r -s -p "Password: " password

        echo
    fi


    # --------------------------------------------------------
    # Connection information
    # --------------------------------------------------------

    echo
    echo -e "${GREEN}Connecting...${NC}"
    echo
    echo "  Alias    : $alias"
    echo "  User     : $user"
    echo "  Host     : $host"
    echo "  Port     : $port"
    echo


    # --------------------------------------------------------
    # SSH options
    # --------------------------------------------------------

    get_ssh_options


    # --------------------------------------------------------
    # Debug
    # --------------------------------------------------------

    if [ "$debug" -eq 1 ]; then

        echo -e "${YELLOW}SSH debug mode enabled.${NC}"
        echo


        sshpass -p "$password" \
            ssh \
            -vvv \
            "${SSH_OPTIONS[@]}" \
            -p "$port" \
            "$user@$host"


        return $?
    fi


    # --------------------------------------------------------
    # Normal SSH
    # --------------------------------------------------------

    sshpass -p "$password" \
        ssh \
        "${SSH_OPTIONS[@]}" \
        -p "$port" \
        "$user@$host"


    return $?
}


# ============================================================
# SCP
# ============================================================

scp_connect() {

    local custom_user=""
    local custom_port=""


    # --------------------------------------------------------
    # Parse options
    # --------------------------------------------------------

    while [ $# -gt 0 ]
    do

        case "$1" in

            --user)

                if [ -z "$2" ]; then

                    echo -e "${RED}Error: --user requires a value.${NC}"

                    return 1
                fi

                custom_user="$2"

                shift 2
                ;;


            --port)

                if [ -z "$2" ]; then

                    echo -e "${RED}Error: --port requires a value.${NC}"

                    return 1
                fi

                custom_port="$2"

                shift 2
                ;;


            --help|-h)

                show_help

                return 0
                ;;


            *)

                break
                ;;

        esac

    done


    # --------------------------------------------------------
    # Validate arguments
    # --------------------------------------------------------

    if [ $# -lt 3 ]; then

        echo
        echo "Usage:"
        echo
        echo "  sabid scp <alias> <SRC> <DST>"
        echo
        echo "  sabid scp --user USER <alias> <SRC> <DST>"
        echo
        echo "  sabid scp --port PORT <alias> <SRC> <DST>"
        echo

        return 1
    fi


    local input_alias="$1"
    local source="$2"
    local destination="$3"


    # --------------------------------------------------------
    # Resolve alias
    # --------------------------------------------------------

    if ! resolve_alias "$input_alias"; then

        return 1
    fi


    local alias="$MATCHED_ALIAS"


    # --------------------------------------------------------
    # Get server
    # --------------------------------------------------------

    if ! get_server "$alias"; then

        echo -e "${RED}Server not found: $alias${NC}"

        return 1
    fi


    local user="$SERVER_USER"
    local host="$SERVER_HOST"
    local password="$SERVER_PASSWORD"
    local port="$SERVER_PORT"


    # --------------------------------------------------------
    # Overrides
    # --------------------------------------------------------

    [ -n "$custom_user" ] && user="$custom_user"

    [ -n "$custom_port" ] && port="$custom_port"


    # --------------------------------------------------------
    # Default port
    # --------------------------------------------------------

    [ -z "$port" ] && port=22


    # --------------------------------------------------------
    # Validate
    # --------------------------------------------------------

    if ! validate_port "$port"; then

        return 1
    fi


    if [ -z "$user" ]; then

        echo -e "${RED}Username is empty for alias: $alias${NC}"

        return 1
    fi


    if [ -z "$host" ]; then

        echo -e "${RED}Host is empty for alias: $alias${NC}"

        return 1
    fi


    # --------------------------------------------------------
    # Password
    # --------------------------------------------------------

    if [ -z "$password" ]; then

        echo
        echo "Password required for $user@$host"

        read -r -s -p "Password: " password

        echo
    fi


    # --------------------------------------------------------
    # Display
    # --------------------------------------------------------

    echo
    echo -e "${GREEN}Starting SCP...${NC}"
    echo
    echo "  Alias       : $alias"
    echo "  User        : $user"
    echo "  Host        : $host"
    echo "  Port        : $port"
    echo "  Source      : $source"
    echo "  Destination : $destination"
    echo


    # --------------------------------------------------------
    # SSH options for SCP
    # --------------------------------------------------------

    get_ssh_options


    # --------------------------------------------------------
    # SCP
    # --------------------------------------------------------

    sshpass -p "$password" \
        scp \
        "${SSH_OPTIONS[@]}" \
        -P "$port" \
        "$source" \
        "$user@$host:$destination"


    return $?
}


# ============================================================
# List servers
# ============================================================

list_servers() {

    clean_csv


    local filter="$1"


    echo


    printf "%-20s %-20s %-25s %-8s\n" \
        "ALIAS" \
        "USERNAME" \
        "HOST" \
        "PORT"


    printf "%-20s %-20s %-25s %-8s\n" \
        "--------------------" \
        "--------------------" \
        "-------------------------" \
        "--------"


    local alias
    local user
    local host
    local password
    local port


    local found=0


    while IFS=',' read -r alias user host password port
    do

        [ "$alias" = "alias_name" ] && continue
        [ -z "$alias" ] && continue


        if [ -n "$filter" ]; then

            case "$alias" in

                "$filter"*)
                    ;;

                *)
                    continue
                    ;;

            esac
        fi


        [ -z "$port" ] && port=22


        printf "%-20s %-20s %-25s %-8s\n" \
            "$alias" \
            "$user" \
            "$host" \
            "$port"


        found=1


    done < "$CSV"


    echo


    if [ "$found" -eq 0 ]; then

        echo "No servers found."
        echo

    fi
}


# ============================================================
# Add server
# ============================================================

add_server() {

    local alias="$1"
    local user="$2"
    local host="$3"
    local password="$4"
    local port="$5"


    if [ -z "$alias" ] ||
       [ -z "$user" ] ||
       [ -z "$host" ]; then

        echo
        echo "Usage:"
        echo
        echo "  sabid ssh add <alias> <user> <host> [password] [port]"
        echo

        return 1
    fi


    [ -z "$port" ] && port=22


    if ! validate_port "$port"; then

        return 1
    fi


    # --------------------------------------------------------
    # Duplicate alias
    # --------------------------------------------------------

    local existing


    existing=$(awk -F',' -v a="$alias" '
        NR > 1 && $1 == a {
            print $1
        }
    ' "$CSV")


    if [ -n "$existing" ]; then

        echo
        echo -e "${RED}Alias already exists: $alias${NC}"
        echo

        return 1
    fi


    # --------------------------------------------------------
    # Password
    # --------------------------------------------------------

    if [ -z "$password" ]; then

        read -r -s \
            -p "Password for $user@$host: " \
            password

        echo
    fi


    # --------------------------------------------------------
    # Add
    # --------------------------------------------------------

    echo "$alias,$user,$host,$password,$port" >> "$CSV"

    chmod 600 "$CSV"


    echo
    echo -e "${GREEN}Server added successfully.${NC}"
    echo
    echo "  Alias : $alias"
    echo "  User  : $user"
    echo "  Host  : $host"
    echo "  Port  : $port"
    echo
}


# ============================================================
# Remove server
# ============================================================

remove_server() {

    local target="$1"


    if [ -z "$target" ]; then

        echo
        echo "Usage:"
        echo
        echo "  sabid ssh remove <alias>"
        echo
        echo "  sabid ssh remove --all"
        echo

        return 1
    fi


    # --------------------------------------------------------
    # Remove all
    # --------------------------------------------------------

    if [ "$target" = "--all" ]; then

        echo


        read -r \
            -p "Remove ALL servers? Type YES to confirm: " \
            confirm


        if [ "$confirm" != "YES" ]; then

            echo "Cancelled."
            echo

            return 1
        fi


        echo "alias_name,server_username,server_ip,password,port" > "$CSV"

        chmod 600 "$CSV"


        echo
        echo -e "${GREEN}All servers removed.${NC}"
        echo

        return 0
    fi


    # --------------------------------------------------------
    # Resolve alias
    # --------------------------------------------------------

    if ! resolve_alias "$target"; then

        return 1
    fi


    local alias="$MATCHED_ALIAS"


    # --------------------------------------------------------
    # Confirm
    # --------------------------------------------------------

    echo


    read -r \
        -p "Remove server '$alias'? [y/N]: " \
        confirm


    case "$confirm" in

        y|Y|yes|YES)
            ;;

        *)
            echo "Cancelled."
            echo

            return 1
            ;;

    esac


    # --------------------------------------------------------
    # Temporary file
    # --------------------------------------------------------

    local temp_file="${CSV}.tmp"


    awk -F',' -v target="$alias" '
        NR == 1 || $1 != target
    ' "$CSV" > "$temp_file"


    mv "$temp_file" "$CSV"

    chmod 600 "$CSV"


    echo
    echo -e "${GREEN}Server removed: $alias${NC}"
    echo
}


# ============================================================
# Clean command
# ============================================================

clean_command() {

    clean_csv


    echo
    echo -e "${GREEN}CSV cleaned successfully.${NC}"
    echo
    echo "File:"
    echo "  $CSV"
    echo
}


# ============================================================
# Handle SSH
# ============================================================

handle_ssh() {

    shift


    if [ $# -eq 0 ]; then

        show_help

        return 0
    fi


    case "$1" in

        list)

            shift

            list_servers "$1"
            ;;


        clean)

            clean_command
            ;;


        add)

            shift

            add_server \
                "$1" \
                "$2" \
                "$3" \
                "$4" \
                "$5"
            ;;


        remove)

            shift

            remove_server "$1"
            ;;


        --help|-h)

            show_help
            ;;


        *)

            local alias="$1"

            shift

            ssh_connect "$alias" "$@"
            ;;

    esac
}


# ============================================================
# Handle SCP
# ============================================================

handle_scp() {

    shift


    if [ $# -eq 0 ]; then

        show_help

        return 0
    fi


    scp_connect "$@"
}


# ============================================================
# Main
# ============================================================

init


if [ $# -eq 0 ]; then

    show_help

    exit 0
fi


case "$1" in

    ssh)

        check_requirements

        handle_ssh "$@"
        ;;


    scp)

        check_requirements

        handle_scp "$@"
        ;;


    --help|-h)

        show_help
        ;;


    *)

        echo
        echo -e "${RED}Unknown command: $1${NC}"
        echo

        show_help

        exit 1
        ;;

esac
