```bash
#!/bin/bash

# ============================================================
# sabid - SSH / SCP Quick Connection Manager
# ============================================================
#
# CSV:
#   ~/.ssh/quickssh/servers.csv
#
# FORMAT:
#   alias_name,server_username,server_ip,password,port
#
# EXAMPLES:
#
#   sabid ssh us
#   sabid ssh u
#   sabid ssh us-m
#   sabid ssh us --user root
#   sabid ssh us --port 2222
#   sabid ssh us --debug
#
#   sabid scp us /tmp/test.txt /tmp/
#   sabid scp --user root us /tmp/test.txt /tmp/
#   sabid scp --port 2222 us /tmp/test.txt /tmp/
#
# ============================================================


CSV="$HOME/.ssh/quickssh/servers.csv"
SSH_DIR="$HOME/.ssh/quickssh"


# ============================================================
# Colors
# ============================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'


# ============================================================
# Initialize
# ============================================================

init() {

    mkdir -p "$SSH_DIR"
    chmod 700 "$SSH_DIR"

    if [ ! -f "$CSV" ]; then
        echo "alias_name,server_username,server_ip,password,port" > "$CSV"
    fi

    chmod 600 "$CSV"

    clean_csv
}


# ============================================================
# Clean CSV
#
# Removes Windows CRLF characters.
# ============================================================

clean_csv() {

    if [ ! -f "$CSV" ]; then
        return 0
    fi

    if command -v perl >/dev/null 2>&1; then
        perl -pi -e 's/\r$//' "$CSV"
    fi

    chmod 600 "$CSV"
}


# ============================================================
# Check requirements
# ============================================================

check_requirements() {

    if ! command -v ssh >/dev/null 2>&1; then

        echo -e "${RED}Error: ssh is not installed.${NC}"
        exit 1
    fi


    if ! command -v sshpass >/dev/null 2>&1; then

        echo -e "${RED}Error: sshpass is not installed.${NC}"
        echo

        if [[ "$OSTYPE" == "darwin"* ]]; then

            echo "Install on macOS:"
            echo
            echo "  brew install hudochenkov/sshpass/sshpass"

        else

            echo "Install on Ubuntu/Debian:"
            echo
            echo "  sudo apt-get update"
            echo "  sudo apt-get install -y sshpass"

        fi

        exit 1
    fi
}


